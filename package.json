{
  "name": "@laioutr/app-turnstile",
  "version": "0.0.0",
  "description": "Cloudflare Turnstile as the bot-protection provider for Laioutr actions",
  "repository": "laioutr/app-turnstile",
  "license": "MIT",
  "keywords": [
    "laioutr",
    "laioutr-app",
    "cloudflare",
    "turnstile",
    "bot-protection"
  ],
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "rc:fetch": "laioutr rc fetch",
    "lint": "eslint .",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "@opentelemetry/api": "^1.9.0",
    "defu": "6.1.4",
    "h3": "^1.15.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@laioutr-core/devtools": "^0.57.1",
    "@laioutr-core/frontend-core": "^0.57.1",
    "@laioutr/cli": "^0.4.1",
    "@laioutr/eslint-config": "^1.8.8",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@types/node": "latest",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "happy-dom": "^20.14.5",
    "nuxt": "3.16.2",
    "pinia": "3.0.2",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/frontend-core": ">=0.55.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
